<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LW Atelier</title>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Tenor+Sans&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --cream: #f7f4ef;
      --bone: #ede8df;
      --warm-black: #1a1714;
      --muted: #8a847a;
      --accent: #c4a882;
      --serif: 'Cormorant Garamond', Georgia, serif;
      --sans: 'Tenor Sans', sans-serif;
    }

    html { scroll-behavior: smooth; }

    body {
      background: var(--cream);
      color: var(--warm-black);
      font-family: var(--serif);
      overflow-x: hidden;
      cursor: auto;
    }

    body a, body button, body li { cursor: none; }

    /* --- CURSOR --- */
    .cursor {
      position: fixed;
      width: 8px; height: 8px;
      background: var(--warm-black);
      border-radius: 50%;
      pointer-events: none;
      z-index: 9999;
      transform: translate(-50%, -50%);
      transition: width 0.3s, height 0.3s, background 0.3s;
    }
    .cursor.expand {
      width: 40px; height: 40px;
      background: transparent;
      border: 1px solid var(--warm-black);
    }

    /* --- NAV --- */
    nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 2rem 3rem;
      mix-blend-mode: multiply;
    }

    .nav-logo {
      font-family: var(--serif);
      font-weight: 300;
      font-size: 0.95rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--warm-black);
    }

    .nav-links {
      display: flex;
      gap: 2.5rem;
      list-style: none;
    }

    .nav-links a {
      font-family: var(--sans);
      font-size: 0.7rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--warm-black);
      opacity: 0.6;
      transition: opacity 0.3s;
    }

    .nav-links a:hover { opacity: 1; }

    /* --- HERO --- */
    .hero {
      min-height: 100vh;
      display: grid;
      grid-template-columns: 1fr 1fr;
      position: relative;
    }

    .hero-left {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 8rem 3rem 6rem;
    }

    .hero-eyebrow {
      font-family: var(--sans);
      font-size: 0.65rem;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 2rem;
      opacity: 0;
      animation: fadeUp 1s ease 0.3s forwards;
    }

    .hero-title {
      font-size: clamp(4rem, 7vw, 7rem);
      font-weight: 300;
      line-height: 0.95;
      letter-spacing: -0.02em;
      margin-bottom: 2.5rem;
      opacity: 0;
      animation: fadeUp 1s ease 0.5s forwards;
    }

    .hero-title em {
      font-style: italic;
      color: var(--accent);
    }

    .hero-sub {
      font-size: 1rem;
      font-weight: 300;
      line-height: 1.8;
      color: var(--muted);
      max-width: 360px;
      opacity: 0;
      animation: fadeUp 1s ease 0.7s forwards;
      margin-bottom: 1.8rem;
    }

    .hero-anchors {
      display: flex;
      align-items: center;
      margin-bottom: 2.5rem;
      opacity: 0;
      animation: fadeUp 1s ease 0.85s forwards;
      flex-wrap: wrap;
      gap: 0.2rem 0;
    }

    .hero-anchors a {
      font-family: var(--sans);
      font-size: 0.58rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--muted);
      transition: color 0.3s;
    }

    .hero-anchors a:hover { color: var(--warm-black); }

    .hero-anchors span {
      font-family: var(--sans);
      font-size: 0.5rem;
      color: var(--accent);
      margin: 0 0.8rem;
      opacity: 0.6;
    }

    .hero-cta {
      opacity: 0;
      animation: fadeUp 1s ease 1s forwards;
    }

    .btn {
      display: inline-block;
      font-family: var(--sans);
      font-size: 0.65rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--warm-black);
      border-bottom: 1px solid var(--warm-black);
      padding-bottom: 0.4rem;
      transition: color 0.3s, border-color 0.3s;
    }

    .btn:hover { color: var(--accent); border-color: var(--accent); }

    .hero-right {
      position: relative;
      background: var(--bone);
      overflow: hidden;
    }

    .hero-image-placeholder {
      width: 100%;
      height: 100%;
      background: linear-gradient(160deg, var(--bone) 0%, #d9cfc3 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    .hero-image-placeholder::before {
      content: '';
      position: absolute;
      inset: 0;
      background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23b8a898' fill-opacity='0.15'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }

    .hero-image-text {
      font-family: var(--serif);
      font-style: italic;
      font-size: 1rem;
      color: var(--muted);
      text-align: center;
      letter-spacing: 0.05em;
      position: relative;
      z-index: 1;
      line-height: 2;
    }

    .hero-number {
      position: absolute;
      bottom: 3rem;
      right: 3rem;
      font-family: var(--sans);
      font-size: 0.6rem;
      letter-spacing: 0.2em;
      color: var(--muted);
      writing-mode: vertical-rl;
    }

    /* --- MARQUEE --- */
    .marquee-wrap {
      overflow: hidden;
      padding: 1.2rem 0;
      background: var(--warm-black);
    }

    .marquee-track {
      display: flex;
      gap: 4rem;
      animation: marquee 24s linear infinite;
      width: max-content;
    }

    .marquee-item {
      font-family: var(--sans);
      font-size: 0.6rem;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--cream);
      opacity: 0.7;
      white-space: nowrap;
      display: flex;
      align-items: center;
      gap: 2rem;
    }

    .marquee-item::after {
      content: '◆';
      font-size: 0.4rem;
      opacity: 0.4;
    }

    /* --- OFFERINGS --- */
    .offerings {
      padding: 8rem 3rem;
    }

    .section-label {
      font-family: var(--sans);
      font-size: 0.6rem;
      letter-spacing: 0.35em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 5rem;
    }

    .offering-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
    }

    .offering {
      padding: 3rem;
      border-left: 1px solid var(--bone);
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.8s ease, transform 0.8s ease;
    }

    .offering:last-child { border-right: 1px solid var(--bone); }
    .offering.visible { opacity: 1; transform: translateY(0); }
    .offering:nth-child(2) { transition-delay: 0.15s; }
    .offering:nth-child(3) { transition-delay: 0.3s; }

    .offering-num {
      font-family: var(--sans);
      font-size: 0.55rem;
      letter-spacing: 0.2em;
      color: var(--muted);
      margin-bottom: 3rem;
    }

    .offering-image {
      width: 100%;
      aspect-ratio: 3/4;
      background: var(--bone);
      margin-bottom: 2.5rem;
      overflow: hidden;
      position: relative;
    }

    .offering-image-inner {
      width: 100%;
      height: 100%;
      transition: transform 0.8s ease;
    }

    .offering:hover .offering-image-inner { transform: scale(1.04); }

    .offering-img-placeholder {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--serif);
      font-style: italic;
      font-size: 0.9rem;
      color: var(--muted);
      letter-spacing: 0.05em;
    }

    .offering:nth-child(1) .offering-image { background: linear-gradient(145deg, #e8ddd0 0%, #cfc3b4 100%); }
    .offering:nth-child(2) .offering-image { background: linear-gradient(145deg, #d6dcd8 0%, #b8c4bc 100%); }
    .offering:nth-child(3) .offering-image { background: linear-gradient(145deg, #ddd0d6 0%, #c4b4bc 100%); }

    .offering-title {
      font-size: 1.8rem;
      font-weight: 300;
      letter-spacing: -0.01em;
      margin-bottom: 0.5rem;
    }

    .offering-title em { font-style: italic; }

    .offering-credentials {
      font-family: var(--sans);
      font-size: 0.6rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 1.5rem;
    }

    .offering-desc {
      font-size: 0.95rem;
      line-height: 1.9;
      color: var(--muted);
      font-weight: 300;
      margin-bottom: 2rem;
    }

    .offering-services {
      list-style: none;
      border-top: 1px solid var(--bone);
      padding-top: 1.5rem;
    }

    .offering-services li {
      font-family: var(--sans);
      font-size: 0.62rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      padding: 0.65rem 0;
      border-bottom: 1px solid var(--bone);
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: color 0.3s;
    }

    .offering-services li:hover { color: var(--warm-black); }
    .offering-services li::after { content: '→'; opacity: 0.2; font-family: serif; font-size: 0.9rem; }

    /* --- COLLECTION --- */
    .collection {
      background: var(--warm-black);
      padding: 8rem 3rem;
      position: relative;
      overflow: hidden;
    }

    .collection::before {
      content: 'Collection';
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-family: var(--serif);
      font-size: clamp(8rem, 18vw, 18rem);
      font-weight: 300;
      font-style: italic;
      color: rgba(255,255,255,0.025);
      white-space: nowrap;
      pointer-events: none;
      letter-spacing: -0.02em;
    }

    .collection-inner {
      max-width: 780px;
      margin: 0 auto;
      text-align: center;
      position: relative;
      z-index: 1;
    }

    .collection-eyebrow {
      font-family: var(--sans);
      font-size: 0.6rem;
      letter-spacing: 0.35em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 2rem;
    }

    .collection-title {
      font-size: clamp(2.8rem, 5vw, 4.5rem);
      font-weight: 300;
      color: var(--cream);
      line-height: 1.05;
      margin-bottom: 2rem;
      letter-spacing: -0.01em;
    }

    .collection-title em { font-style: italic; color: var(--accent); }

    .collection-sub {
      font-size: 1rem;
      line-height: 1.9;
      color: var(--muted);
      font-weight: 300;
      margin-bottom: 4rem;
      max-width: 560px;
      margin-left: auto;
      margin-right: auto;
    }

    .collection-divider {
      width: 1px;
      height: 3rem;
      background: rgba(255,255,255,0.15);
      margin: 0 auto 4rem;
    }

    .collection-phases {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
      text-align: left;
      border-top: 1px solid rgba(255,255,255,0.08);
    }

    .phase {
      padding: 3rem 2.5rem;
      border-right: 1px solid rgba(255,255,255,0.08);
    }

    .phase:last-child { border-right: none; }

    .phase-label {
      font-family: var(--sans);
      font-size: 0.55rem;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 1.2rem;
    }

    .phase-title {
      font-size: 1.4rem;
      font-weight: 300;
      color: var(--cream);
      margin-bottom: 1rem;
    }

    .phase-title em { font-style: italic; color: var(--accent); }

    .phase-desc {
      font-size: 0.9rem;
      line-height: 1.9;
      color: var(--muted);
      font-weight: 300;
    }

    .collection-cta {
      margin-top: 4rem;
      text-align: center;
    }

    .btn-light {
      display: inline-block;
      font-family: var(--sans);
      font-size: 0.65rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--cream);
      border-bottom: 1px solid rgba(255,255,255,0.3);
      padding-bottom: 0.4rem;
      transition: color 0.3s, border-color 0.3s;
    }

    .btn-light:hover { color: var(--accent); border-color: var(--accent); }

    /* --- ABOUT --- */
    .about {
      padding: 8rem 3rem;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8rem;
      align-items: center;
      border-top: 1px solid var(--bone);
    }

    .about-image {
      aspect-ratio: 4/5;
      background: linear-gradient(160deg, var(--bone) 0%, #cfc3b4 100%);
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .about-image::after {
      content: '';
      position: absolute;
      bottom: -1.5rem;
      right: -1.5rem;
      width: 60%;
      height: 60%;
      border: 1px solid var(--bone);
      z-index: -1;
    }

    .about-image-text {
      font-family: var(--serif);
      font-style: italic;
      color: var(--muted);
      font-size: 0.9rem;
      letter-spacing: 0.05em;
    }

    .about-eyebrow {
      font-family: var(--sans);
      font-size: 0.6rem;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 2rem;
    }

    .about-title {
      font-size: clamp(2.5rem, 4vw, 3.5rem);
      font-weight: 300;
      line-height: 1.15;
      margin-bottom: 2rem;
    }

    .about-title em { font-style: italic; color: var(--accent); }

    .about-text {
      font-size: 1rem;
      line-height: 2;
      color: var(--muted);
      font-weight: 300;
      margin-bottom: 3rem;
    }

    /* --- CONTACT --- */
    .contact {
      background: var(--warm-black);
      padding: 8rem 3rem;
      text-align: center;
    }

    .contact-eyebrow {
      font-family: var(--sans);
      font-size: 0.6rem;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 2rem;
    }

    .contact-title {
      font-size: clamp(3rem, 6vw, 5.5rem);
      font-weight: 300;
      color: var(--cream);
      line-height: 1.1;
      margin-bottom: 1rem;
    }

    .contact-title em { font-style: italic; color: var(--accent); }

    .contact-sub {
      font-size: 1rem;
      color: var(--muted);
      font-weight: 300;
      margin-bottom: 3.5rem;
      line-height: 1.8;
    }

    .contact-email {
      display: inline-block;
      font-family: var(--serif);
      font-style: italic;
      font-size: 1.1rem;
      color: var(--cream);
      text-decoration: none;
      border-bottom: 1px solid var(--muted);
      padding-bottom: 0.3rem;
      transition: border-color 0.3s, color 0.3s;
      margin-bottom: 4rem;
    }

    .contact-email:hover { border-color: var(--accent); color: var(--accent); }

    .contact-divider {
      width: 1px;
      height: 4rem;
      background: var(--muted);
      margin: 0 auto 4rem;
      opacity: 0.3;
    }

    /* --- FOOTER --- */
    footer {
      background: var(--warm-black);
      border-top: 1px solid rgba(255,255,255,0.07);
      padding: 2.5rem 3rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .footer-logo {
      font-family: var(--serif);
      font-weight: 300;
      font-size: 0.85rem;
      letter-spacing: 0.2em;
      color: var(--cream);
      opacity: 0.5;
      text-transform: uppercase;
    }

    .footer-copy {
      font-family: var(--sans);
      font-size: 0.55rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--muted);
      opacity: 0.5;
    }

    .footer-links {
      display: flex;
      gap: 2rem;
      list-style: none;
    }

    .footer-links a {
      font-family: var(--sans);
      font-size: 0.55rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--muted);
      text-decoration: none;
      opacity: 0.5;
      transition: opacity 0.3s;
    }

    .footer-links a:hover { opacity: 1; }

    /* --- ANIMATIONS --- */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes marquee {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }

    /* --- RESPONSIVE --- */
    @media (max-width: 900px) {
      nav { padding: 1.5rem 1.5rem; }
      .nav-links { display: none; }
      .hero { grid-template-columns: 1fr; min-height: auto; }
      .hero-left { padding: 8rem 1.5rem 3rem; }
      .hero-right { height: 60vw; }
      .offerings { padding: 5rem 1.5rem; }
      .offering-grid { grid-template-columns: 1fr; }
      .offering { border-left: none; border-top: 1px solid var(--bone); border-right: none !important; padding: 2.5rem 0; }
      .collection { padding: 5rem 1.5rem; }
      .collection-phases { grid-template-columns: 1fr; }
      .phase { border-right: none; border-bottom: 1px solid rgba(255,255,255,0.08); padding: 2.5rem 0; }
      .phase:last-child { border-bottom: none; }
      .about { grid-template-columns: 1fr; gap: 3rem; padding: 5rem 1.5rem; }
      .contact { padding: 5rem 1.5rem; }
      footer { flex-direction: column; gap: 1.5rem; text-align: center; padding: 2rem 1.5rem; }
      body a, body button, body li { cursor: auto; }
      .cursor { display: none; }
    }
  </style>
</head>
<body>

  <div class="cursor" id="cursor"></div>

  <!-- NAV -->
  <nav>
    <a href="#" class="nav-logo">LW Atelier</a>
    <ul class="nav-links">
      <li><a href="#offerings">Offerings</a></li>
      <li><a href="#collection">The Collection</a></li>
      <li><a href="#about">About</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>
  </nav>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-left">
      <p class="hero-eyebrow">Wichita, Kansas &nbsp;·&nbsp; Est. 2025</p>
      <h1 class="hero-title">LW<br /><em>Atelier</em></h1>
      <p class="hero-sub">Creative direction and fine art photography. A singular personal experience for those who appreciate the quiet luxury of an intentional life.</p>
      <div class="hero-anchors">
        <a href="#movement">Somatic Movement</a>
        <span>·</span>
        <a href="#style">Wardrobe Edit</a>
        <span>·</span>
        <a href="#image">The Polaroid</a>
      </div>
      <div class="hero-cta">
        <a href="#offerings" class="btn">Explore Offerings</a>
      </div>
    </div>
    <div class="hero-right">
      <div class="hero-image-placeholder">
        <p class="hero-image-text">Your image here</p>
      </div>
      <span class="hero-number">LW — 001</span>
    </div>
  </section>

  <!-- MARQUEE -->
  <div class="marquee-wrap">
    <div class="marquee-track">
      <span class="marquee-item">Creative Direction</span>
      <span class="marquee-item">Fine Art Photography</span>
      <span class="marquee-item">Somatic Movement</span>
      <span class="marquee-item">Wardrobe Edit</span>
      <span class="marquee-item">Style Curation</span>
      <span class="marquee-item">Instant Film</span>
      <span class="marquee-item">Archival Portrait</span>
      <span class="marquee-item">Creative Direction</span>
      <span class="marquee-item">Fine Art Photography</span>
      <span class="marquee-item">Somatic Movement</span>
      <span class="marquee-item">Wardrobe Edit</span>
      <span class="marquee-item">Style Curation</span>
      <span class="marquee-item">Instant Film</span>
      <span class="marquee-item">Archival Portrait</span>
    </div>
  </div>

  <!-- OFFERINGS -->
  <section class="offerings" id="offerings">
    <p class="section-label">— The Pillars</p>
    <div class="offering-grid">

      <!-- MOVEMENT -->
      <div class="offering" id="movement">
        <p class="offering-num">No. I</p>
        <div class="offering-image">
          <div class="offering-image-inner">
            <div class="offering-img-placeholder">Your image here</div>
          </div>
        </div>
        <h2 class="offering-title">Somatic<br /><em>Movement</em></h2>
        <p class="offering-credentials">Posture &nbsp;·&nbsp; Breath &nbsp;·&nbsp; Alignment</p>
        <p class="offering-desc">Intentional movement designed around physical presence, grace, and structure. Treating the body as the ultimate canvas of strength and fluid alignment.</p>
        <ul class="offering-services">
          <li>1:1 Personal Movement</li>
          <li>Private Yoga Alignment</li>
          <li>Custom Somatic Programming</li>
        </ul>
      </div>

